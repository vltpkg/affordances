{
  "name": "@afford/react",
  "version": "0.0.0",
  "description": "Afford for React: WebMCP tools from the page graph, and <Affordance> markers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afford/afford.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev": {
      "types": "./dist/dev.d.ts",
      "default": "./dist/dev.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@afford/protocol": "workspace:*"
  },
  "devDependencies": {
    "@afford/core": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=19"
  }
}
