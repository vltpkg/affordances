{
  "name": "@afford/protocol",
  "version": "0.0.0",
  "description": "Afford protocol: types, JSON Schemas, and the spec",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afford/afford.git",
    "directory": "packages/protocol"
  },
  "files": [
    "dist",
    "schemas",
    "fixtures",
    "spec.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas/*.json": "./schemas/*.json",
    "./fixtures/*": "./fixtures/*",
    "./spec.md": "./spec.md"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "schemas": "node scripts/schemas.ts"
  },
  "dependencies": {
    "zod": "^4.6.7"
  }
}
