{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Graph",
  "$defs": {
    "Graph": {
      "type": "object",
      "properties": {
        "v": {
          "type": "string",
          "const": "0"
        },
        "page": {
          "type": "string",
          "description": "Concrete path, e.g. /products/tee"
        },
        "route": {
          "type": "string",
          "description": "Route pattern, e.g. /products/[slug]"
        },
        "entities": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionDescriptor"
          }
        },
        "nav": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "to": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "when": {
                "type": "string"
              }
            },
            "required": ["to"],
            "additionalProperties": false
          }
        },
        "md": {
          "description": "Optional Markdown alternative of the page content",
          "type": "string"
        }
      },
      "required": ["v", "page", "route", "entities", "actions"],
      "additionalProperties": false
    },
    "ActionDescriptor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Stable, unique per route"
        },
        "description": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "A JSON Schema object"
        },
        "output": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "A JSON Schema object"
        },
        "expose": {
          "type": "string",
          "enum": ["public", "session", "confirm"]
        },
        "guard": {
          "description": "Human-readable precondition",
          "type": "string"
        },
        "available": {
          "type": "boolean",
          "description": "The guard, evaluated for this request"
        },
        "reason": {
          "description": "Why the action is unavailable",
          "type": "string"
        },
        "effects": {
          "description": "Entity keys this action changes",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "required": ["name", "description", "input", "expose", "available"],
      "additionalProperties": false
    }
  }
}
