{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/SiteIndex",
  "$defs": {
    "SiteIndex": {
      "type": "object",
      "properties": {
        "v": {
          "type": "string",
          "const": "0"
        },
        "name": {
          "type": "string"
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "route": {
                "type": "string"
              },
              "description": {
                "description": "What the page is for, in one line",
                "type": "string"
              },
              "actions": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/ActionSummary"
                }
              }
            },
            "required": ["route", "actions"],
            "additionalProperties": false
          }
        },
        "auth": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["cookie", "bearer"]
          }
        },
        "mcp": {
          "description": "URL of an MCP endpoint for this site",
          "type": "string"
        }
      },
      "required": ["v", "routes", "auth"],
      "additionalProperties": false
    },
    "ActionSummary": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Stable, unique per route"
        },
        "description": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "A JSON Schema object"
        },
        "output": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "A JSON Schema object"
        },
        "expose": {
          "type": "string",
          "enum": ["public", "session", "confirm"]
        },
        "guard": {
          "description": "Human-readable precondition",
          "type": "string"
        },
        "effects": {
          "description": "Entity keys this action changes",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "required": ["name", "description", "input", "expose"],
      "additionalProperties": false
    }
  }
}
