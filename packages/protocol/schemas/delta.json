{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Delta",
  "$defs": {
    "Delta": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "changed": {
          "description": "Only the action's effects keys",
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "actionsAdded": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionDescriptor"
          }
        },
        "actionsRemoved": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "redirect": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string",
              "enum": [
                "not_found",
                "invalid_input",
                "unauthorized",
                "confirm_required",
                "unavailable",
                "rate_limited",
                "internal"
              ]
            },
            "message": {
              "type": "string"
            },
            "issues": {}
          },
          "required": ["code", "message"],
          "additionalProperties": false
        }
      },
      "required": ["ok"],
      "additionalProperties": false
    },
    "ActionDescriptor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Stable, unique per route"
        },
        "description": {
          "type": "string"
        },
        "input": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "A JSON Schema object"
        },
        "output": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "A JSON Schema object"
        },
        "expose": {
          "type": "string",
          "enum": ["public", "session", "confirm"]
        },
        "guard": {
          "description": "Human-readable precondition",
          "type": "string"
        },
        "available": {
          "type": "boolean",
          "description": "The guard, evaluated for this request"
        },
        "reason": {
          "description": "Why the action is unavailable",
          "type": "string"
        },
        "effects": {
          "description": "Entity keys this action changes",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "readOnly": {
          "type": "boolean"
        }
      },
      "required": ["name", "description", "input", "expose", "available"],
      "additionalProperties": false
    }
  }
}
