{
  "name": "@affordances/md",
  "version": "0.2.0",
  "description": "Serve any Next.js page as clean markdown at the same URL",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vltpkg/affordances.git",
    "directory": "packages/md"
  },
  "bin": {
    "affordances-md": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./react/client": {
      "types": "./dist/react-client.d.ts",
      "default": "./dist/react-client.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./next/llms": {
      "types": "./dist/next-llms.d.ts",
      "default": "./dist/next-llms.js"
    },
    "./next/llms-full": {
      "types": "./dist/next-llms-full.d.ts",
      "default": "./dist/next-llms-full.js"
    },
    "./next/proxy": {
      "types": "./dist/next-proxy.d.ts",
      "default": "./dist/next-proxy.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hast-util-from-html": "^2.0.3",
    "hast-util-select": "^6.0.4",
    "hast-util-to-mdast": "^10.1.2",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.2.1",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@types/hast": "^3",
    "@types/mdast": "^4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependencies": {
    "next": ">=16",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  }
}
