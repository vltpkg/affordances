{
  "name": "@affordances/lint",
  "version": "0.2.0",
  "description": "Affordances lint rules for ESLint and oxlint: require-affordance, static-action-name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vltpkg/affordances.git",
    "directory": "packages/lint"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "devDependencies": {
    "eslint": "^10"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  }
}
