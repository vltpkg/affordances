    {
      "id": "hosting.plan.subscribe",
      "kind": "action",
      "description": "Move a project to this plan. Charges the plan's price now, then every month until cancelled",
      "binding": {
        "route": "/plans",
        "action": "subscribe"
      },
      "target": "hosting.plan",
      "input": {
        "type": "object",
        "properties": {
          "plan": {
            "type": "string"
          },
          "projectId": {
            "type": "string"
          }
        },
        "required": ["plan", "projectId"]
      },
      "authorization": {
        "principal": "authenticated"
      },
      "confirmation": {
        "summary": "Move {project.id} to {target.name}, for {target.priceUsd} USD a month"
      },
      "preconditions": [
        {
          "id": "owns",
          "description": "You own the project",
          "declarative": true
        },
        {
          "id": "notCurrent",
          "description": "The project isn't already on this plan",
          "declarative": true
        }
      ],
      "effects": [
        {
          "description": "Changes the project's plan, and its limits with it",
          "reversibility": "reversible",
          "category": "state",
          "change": "update",
          "resource": "hosting.project"
        },
        {
          "description": "Charges the first month's price now. It isn't refunded",
          "reversibility": "irreversible",
          "category": "financial",
          "amount": {
            "value": "target.priceUsd",
            "currency": "USD"
          }
        },
        {
          "description": "Renews at the plan's price every month",
          "reversibility": "compensable",
          "compensatedBy": "hosting.subscription.cancel",
          "category": "financial",
          "amount": {
            "value": "target.priceUsd",
            "currency": "USD",
            "per": "month"
          }
        }
      ],
      "claims": [
        {
          "id": "proRecommended",
          "subject": "hosting.plan.subscribe",
          "kind": "recommendation",
          "statement": "Recommended for production projects",
          "applies": {
            "eq": [
              {
                "path": "target.slug"
              },
              {
                "value": "pro"
              }
            ]
          }
        },
        {
          "id": "rollbackBenefit",
          "subject": "hosting.plan.subscribe",
          "kind": "benefit",
          "statement": "Includes instant rollback, so a bad deployment can be undone in seconds",
          "applies": {
            "eq": [
              {
                "path": "target.rollback"
              },
              {
                "value": true
              }
            ]
          }
        }
      ],
      "relations": [
        {
          "type": "alternativeTo",
          "from": "hosting.bundle.subscribe",
          "to": "hosting.plan.subscribe",
          "description": "A bundle and a plan with separate add-ons serve the same goal"
        }
      ]
    },
